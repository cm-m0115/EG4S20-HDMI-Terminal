# J1 link; verify VCCIO before connection.
# Cross TX J1.13/M14 -> other RX J1.17/D16; common GND J1.12/J1.30.
set_pin_assignment { uart_tx } { LOCATION = M14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { uart_rx } { LOCATION = D16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# A -> B: J1.1/D14 PRESENTED, J1.2/G11 DONE, J1.3/G12 LINK_READY.
set_pin_assignment { gpio_presented_in } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { gpio_done_in } { LOCATION = G11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { gpio_link_ready_in } { LOCATION = G12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
# B user-data SPI Flash U33; configuration Flash pins R11/P10/T3/T10 remain dedicated.
set_pin_assignment { flash_cs_n } { LOCATION = P8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { flash_miso } { LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
